    "@types/better-sqlite3": "^7.6.13",
    "@types/crypto-js": "^4.2.2",
    "@types/glob": "^8.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^22.13.0",
    "@types/react": "~19.2.14",
    "babel-jest": "^29.7.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~57.0.7",
    "better-sqlite3": "^12.11.1",
    "detox": "^20.51.3",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "glob": "^10.4.5",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
